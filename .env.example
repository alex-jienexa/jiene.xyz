# Параметры подключения к базе данных
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=

# Параметры подключения защиты.
# См. backend/README.md для получения советов по созданию собственного
